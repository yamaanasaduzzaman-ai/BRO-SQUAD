rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isRoomMember(roomId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)) ||
        // Allow bootstrap creation if members collection doesn't exist yet
        request.auth.uid != null
      );
    }

    function isRoomAdmin(roomId) {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/rooms/$(roomId)).data.adminUid == request.auth.uid
      );
    }

    // Room root document rules
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      // Allow creation during initial setup or update by admin
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isRoomAdmin(roomId) || isRoomMember(roomId));
      allow delete: if isAuthenticated() && isRoomAdmin(roomId);

      // Members subcollection
      match /members/{memberId} {
        allow read: if isAuthenticated();
        // Allow member creation during room setup or by admin or member saving own profile
        allow create: if isAuthenticated() && (request.auth.uid == memberId || isRoomAdmin(roomId) || !exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(memberId)));
        allow update: if isAuthenticated() && (request.auth.uid == memberId || isRoomAdmin(roomId));
        allow delete: if isAuthenticated() && isRoomAdmin(roomId);
      }

      // Expenses subcollection
      match /expenses/{expenseId} {
        allow read: if isAuthenticated() && isRoomMember(roomId);
        
        // Validation for new expense
        allow create: if isAuthenticated() && isRoomMember(roomId)
          && request.resource.data.amountPaisa is int
          && request.resource.data.amountPaisa > 0
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.payerId is string
          && request.resource.data.participantIds is list
          && request.resource.data.participantIds.size() > 0;

        // Allow update: creator or room admin
        allow update: if isAuthenticated() && isRoomMember(roomId)
          && (resource.data.createdBy == request.auth.uid || isRoomAdmin(roomId))
          && request.resource.data.amountPaisa is int
          && request.resource.data.amountPaisa > 0;

        // Allow delete: creator or room admin
        allow delete: if isAuthenticated() && isRoomMember(roomId)
          && (resource.data.createdBy == request.auth.uid || isRoomAdmin(roomId));
      }

      // Settlements subcollection
      match /settlements/{settlementId} {
        allow read: if isAuthenticated() && isRoomMember(roomId);
        
        allow create: if isAuthenticated() && isRoomMember(roomId)
          && request.resource.data.amountPaisa is int
          && request.resource.data.amountPaisa > 0
          && request.resource.data.fromMemberId is string
          && request.resource.data.toMemberId is string;

        allow update: if isAuthenticated() && isRoomMember(roomId)
          && (resource.data.fromMemberId == request.auth.uid || resource.data.toMemberId == request.auth.uid || isRoomAdmin(roomId));

        allow delete: if isAuthenticated() && isRoomAdmin(roomId);
      }

      // Audit logs subcollection
      match /auditLogs/{logId} {
        allow read: if isAuthenticated() && isRoomMember(roomId);
        allow create: if isAuthenticated() && isRoomMember(roomId);
        allow update, delete: if false; // Audit logs are immutable
      }
    }
  }
}
